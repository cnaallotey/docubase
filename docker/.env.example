# Copy to docker/.env and fill in. Never commit the filled in file.

# Bearer token for the admin API. Generate with: openssl rand -base64 32
DOCUBASE_ADMIN_TOKEN=
# Encrypts stored secrets. Generate with: openssl rand -hex 32. Losing it makes saved keys unreadable.
DOCUBASE_MASTER_KEY=
# Sites are served at <name>.<this domain>, the dashboard at app.<this domain>.
DOCUBASE_BASE_DOMAIN=docs.example.com

# "open" lets anyone create a dashboard account. "closed" means the admin creates accounts.
DOCUBASE_SIGNUP=closed

# Optional billing with Stripe. Set all three or none.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
